{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "postinstall": "node -e \"const fs=require('fs');fs.rmSync('public/vendor/tinymce',{recursive:true,force:true});fs.mkdirSync('public/vendor',{recursive:true});fs.cpSync('node_modules/tinymce','public/vendor/tinymce',{recursive:true,filter:(src)=>!/\\\\.(md|json|ts)$|license|notices/i.test(src)});\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@hotwired/turbo": "^8.0.23",
        "tinymce": "^8.8.2",
        "web-vitals": "^4.2.4"
    }
}
